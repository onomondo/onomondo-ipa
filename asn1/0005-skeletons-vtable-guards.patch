+	0,
+#else
 	OCTET_STRING_decode_xer_binary,
 	BIT_STRING_encode_xer,
+#endif	/* ASN_DISABLE_XER_SUPPORT */
 #ifdef	ASN_DISABLE_OER_SUPPORT
 	0,
 	0,
@@ -39,7 +52,11 @@
