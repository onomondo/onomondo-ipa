From: Benjamin Bruun <bb@onomondo.com>
Subject: [PATCH] skeletons: gate the print/compare/XER/random-fill vtable slots

The generated types reference their codecs only through the asn_OP_*
vtables, so --gc-sections can drop a whole codec family once its slot
is null - the same mechanism the OER/PER removal used. New guards:
ASN_DISABLE_PRINT_SUPPORT, ASN_DISABLE_COMPARE_SUPPORT,
ASN_DISABLE_XER_SUPPORT, ASN_DISABLE_RFILL_SUPPORT. Function bodies
stay compiled; unreferenced ones are discarded at link time.
---
diff --git a/src/ipa/libasn/ANY.c b/src/ipa/libasn/ANY.c
--- a/src/ipa/libasn/ANY.c
+++ b/src/ipa/libasn/ANY.c
@@ -13,12 +13,25 @@
 };
 asn_TYPE_operation_t asn_OP_ANY = {
 	OCTET_STRING_free,
+#ifdef	ASN_DISABLE_PRINT_SUPPORT
+	0,
+#else
 	OCTET_STRING_print,
+#endif	/* ASN_DISABLE_PRINT_SUPPORT */
+#ifdef	ASN_DISABLE_COMPARE_SUPPORT
+	0,
+#else
 	OCTET_STRING_compare,
+#endif	/* ASN_DISABLE_COMPARE_SUPPORT */
 	OCTET_STRING_decode_ber,
 	OCTET_STRING_encode_der,
+#ifdef	ASN_DISABLE_XER_SUPPORT
+	0,
+	0,
+#else
 	OCTET_STRING_decode_xer_hex,
 	ANY_encode_xer,
+#endif	/* ASN_DISABLE_XER_SUPPORT */
 #ifdef	ASN_DISABLE_OER_SUPPORT
 	0,
 	0,
