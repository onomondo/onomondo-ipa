From: Benjamin Bruun <bb@onomondo.com>
Subject: [PATCH] skeletons: drop the PER-only fields of the SEQUENCE and CHOICE tables

oms, roms_count and aoms_count (SEQUENCE) and to/from_canonical_order (CHOICE)
serve the PER codec only, which libasn does not generate; only the compiled-out
UPER functions read them. They go behind ASN_DISABLE_PER_SUPPORT, which
constr_TYPE.h already requires in every unit, so all units share one layout.
The regeneration script writes the generated initialisers through ASN_SEQ_OMS()
and ASN_CHOICE_ORDER().
---
diff --git a/src/ipa/libasn/constr_CHOICE.h b/src/ipa/libasn/constr_CHOICE.h
--- a/src/ipa/libasn/constr_CHOICE.h
+++ b/src/ipa/libasn/constr_CHOICE.h
@@ -26,9 +26,12 @@ typedef struct asn_CHOICE_specifics_s {
 	const asn_TYPE_tag2member_t *tag2el;
 	unsigned tag2el_count;
 
-	/* Canonical ordering of CHOICE elements, for PER */
+	/* Canonical ordering of CHOICE elements, for PER only; constr_TYPE.h
+	 * requires ASN_DISABLE_PER_SUPPORT in every unit, which keeps one layout. */
+#if !defined(ASN_DISABLE_PER_SUPPORT)
 	const unsigned *to_canonical_order;
 	const unsigned *from_canonical_order;
+#endif
 
 	/*
 	 * Extensions-related stuff.
@@ -36,6 +39,13 @@ typedef struct asn_CHOICE_specifics_s {
 	signed ext_start; /* First member of extensions, or -1 */
 } asn_CHOICE_specifics_t;
 
+/* Initialiser for the PER-only fields above. */
+#if defined(ASN_DISABLE_PER_SUPPORT)
+#define ASN_CHOICE_ORDER(to, from)
+#else
+#define ASN_CHOICE_ORDER(to, from) to, from,
+#endif
+
 /*
  * A set specialized functions dealing with the CHOICE type.
  */
diff --git a/src/ipa/libasn/constr_SEQUENCE.h b/src/ipa/libasn/constr_SEQUENCE.h
--- a/src/ipa/libasn/constr_SEQUENCE.h
+++ b/src/ipa/libasn/constr_SEQUENCE.h
@@ -26,11 +26,14 @@ typedef struct asn_SEQUENCE_specifics_s {
 
 	/*
 	 * Optional members of the extensions root (roms) or additions (aoms).
-	 * Meaningful for PER.
+	 * Meaningful for PER only, so they go with it; constr_TYPE.h requires
+	 * ASN_DISABLE_PER_SUPPORT in every unit, which keeps one layout.
 	 */
+#if !defined(ASN_DISABLE_PER_SUPPORT)
 	const int *oms;         /* Optional MemberS */
 	unsigned roms_count;    /* Root optional members count */
 	unsigned aoms_count;    /* Additions optional members count */
+#endif
 
 	/*
 	 * Description of an extensions group.
@@ -40,6 +43,13 @@ typedef struct asn_SEQUENCE_specifics_s {
 	signed first_extension;       /* First extension addition */
 } asn_SEQUENCE_specifics_t;
 
+/* Initialiser for the PER-only fields above. */
+#if defined(ASN_DISABLE_PER_SUPPORT)
+#define ASN_SEQ_OMS(oms, roms_count, aoms_count)
+#else
+#define ASN_SEQ_OMS(oms, roms_count, aoms_count) oms, roms_count, aoms_count,
+#endif
+
 
 /*
  * A set specialized functions dealing with the SEQUENCE type.
