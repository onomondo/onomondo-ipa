From: Benjamin Bruun <bb@onomondo.com>
Subject: [PATCH] skeletons: drop the encoding_constraints slot from the type tables

libasn is generated without OER/PER and with -fno-constraints, so nothing on
the BER/DER paths reads the encoding_constraints tuple. constr_TYPE.h now
defines ASN_DISABLE_ENCODING_CONSTRAINTS itself, before its includes, so every
unit that includes libasn sees one table layout (52 -> 40 B per descriptor and
member on 32-bit); an #error asks for the OER, PER and random-fill defines that
this relies on. Initialisers go through ASN_ENC_CONSTRAINTS(). The code that
reads the field is compiled out with the static helpers and PER tables only it
used: random fill under ASN_DISABLE_RFILL_SUPPORT, the NativeEnumerated and
CHOICE UPER functions and the CUPER case of the SET OF sorter under
ASN_DISABLE_PER_SUPPORT, and asn_check_constraints() with the
CHOICE/SEQUENCE/SET/SET OF walkers under the new define.
---
diff --git a/src/ipa/libasn/ANY.c b/src/ipa/libasn/ANY.c
--- a/src/ipa/libasn/ANY.c
+++ b/src/ipa/libasn/ANY.c
@@ -53,7 +53,7 @@ asn_TYPE_descriptor_t asn_DEF_ANY = {
 	"ANY",
 	&asn_OP_ANY,
 	0, 0, 0, 0,
-	{ 0, 0, asn_generic_no_constraint },	/* No constraints */
+	ASN_ENC_CONSTRAINTS(0, 0, asn_generic_no_constraint)	/* No constraints */
 	0, 0,	/* No members */
 	&asn_SPC_ANY_specs,
 };
diff --git a/src/ipa/libasn/BIT_STRING.c b/src/ipa/libasn/BIT_STRING.c
--- a/src/ipa/libasn/BIT_STRING.c
+++ b/src/ipa/libasn/BIT_STRING.c
@@ -69,7 +69,7 @@ asn_TYPE_descriptor_t asn_DEF_BIT_STRING = {
 	asn_DEF_BIT_STRING_tags,	/* Same as above */
 	sizeof(asn_DEF_BIT_STRING_tags)
 	  / sizeof(asn_DEF_BIT_STRING_tags[0]),
-	{ 0, 0, BIT_STRING_constraint },
+	ASN_ENC_CONSTRAINTS(0, 0, BIT_STRING_constraint)
 	0, 0,	/* No members */
 	&asn_SPC_BIT_STRING_specs
 };
@@ -558,6 +558,7 @@ BIT_STRING_encode_uper(const asn_TYPE_descriptor_t *td,
 
 #endif  /* ASN_DISABLE_PER_SUPPORT */
 
+#if !defined(ASN_DISABLE_RFILL_SUPPORT)
 asn_random_fill_result_t
 BIT_STRING_random_fill(const asn_TYPE_descriptor_t *td, void **sptr,
                        const asn_encoding_constraints_t *constraints,
@@ -667,3 +668,4 @@ BIT_STRING_random_fill(const asn_TYPE_descriptor_t *td, void **sptr,
     result_ok.length = st->size;
     return result_ok;
 }
+#endif	/* !defined(ASN_DISABLE_RFILL_SUPPORT) */
diff --git a/src/ipa/libasn/BMPString.c b/src/ipa/libasn/BMPString.c
--- a/src/ipa/libasn/BMPString.c
+++ b/src/ipa/libasn/BMPString.c
@@ -18,11 +18,13 @@ asn_OCTET_STRING_specifics_t asn_SPC_BMPString_specs = {
 	offsetof(BMPString_t, _asn_ctx),
 	ASN_OSUBV_U16	/* 16-bits character */
 };
+#if !defined(ASN_DISABLE_ENCODING_CONSTRAINTS)
 static asn_per_constraints_t asn_DEF_BMPString_per_constraints = {
 	{ APC_CONSTRAINED, 16, 16, 0, 65535 },
 	{ APC_SEMI_CONSTRAINED, -1, -1, 0, 0 },
 	0, 0
 };
+#endif	/* !defined(ASN_DISABLE_ENCODING_CONSTRAINTS) */
 asn_TYPE_operation_t asn_OP_BMPString = {
 	OCTET_STRING_free,          /* Implemented in terms of OCTET STRING */
 #ifdef	ASN_DISABLE_PRINT_SUPPORT
@@ -75,7 +77,7 @@ asn_TYPE_descriptor_t asn_DEF_BMPString = {
 	asn_DEF_BMPString_tags,
 	sizeof(asn_DEF_BMPString_tags)
 	  / sizeof(asn_DEF_BMPString_tags[0]),
-	{ 0, &asn_DEF_BMPString_per_constraints, BMPString_constraint },
+	ASN_ENC_CONSTRAINTS(0, &asn_DEF_BMPString_per_constraints, BMPString_constraint)
 	0, 0,	/* No members */
 	&asn_SPC_BMPString_specs
 };
